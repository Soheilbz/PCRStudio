{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "incremental": false,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node", "@testing-library/jest-dom"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/pcrstudio-dev-40029/types/**/*.ts",
    ".next/pcrstudio-dev-40029/dev/types/**/*.ts",
    ".next/pcrstudio-dev-3000/types/**/*.ts",
    ".next/pcrstudio-dev-3000/dev/types/**/*.ts",
    ".next/pcrstudio-dev-41119/types/**/*.ts",
    ".next/pcrstudio-dev-41119/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out"]
}
